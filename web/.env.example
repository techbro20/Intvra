# Resend (https://resend.com) API key used by /api/contact to email form submissions.
RESEND_API_KEY=

# Sender address; its domain must be verified in Resend.
CONTACT_FROM="Ai.Intvra <noreply@intvra.com>"

# Inbox that receives contact, bug report and waitlist submissions.
CONTACT_TO=support@intvra.com

# Accounts/checkout server. The pricing buttons link to $NEXT_PUBLIC_API_URL/pay.
NEXT_PUBLIC_API_URL=https://api.intvra.com

# Google Analytics 4 measurement ID. Leave empty to disable analytics (e.g. local dev).
NEXT_PUBLIC_GA_ID=G-7T592THECT
