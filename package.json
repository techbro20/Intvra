{
  "name": "ai-intvra",
  "private": true,
  "version": "0.1.9",
  "description": "Ai.Intvra - real-time AI interview assistant overlay for Windows.",
  "author": "techbro20 <victor.immoh@gmail.com>",
  "homepage": "https://ai.intvra.com",
  "intvra": {
    "apiUrl": "https://api.intvra.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/techbro20/Intvra.git"
  },
  "bugs": {
    "url": "https://github.com/techbro20/Intvra/issues"
  },
  "license": "GPL-3.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "vite": "vite --host 127.0.0.1 --port 1420",
    "electron": "electron .",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && node scripts/package-mac.mjs"
  },
  "dependencies": {
    "@bany/curl-to-json": "^1.2.8",
    "@lobehub/icons-static-svg": "^1.90.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@ricky0123/vad-react": "^0.0.36",
    "@ricky0123/vad-web": "^0.0.30",
    "@tailwindcss/vite": "^4.1.12",
    "@tesseract.js-data/eng": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.539.0",
    "moment": "^2.30.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.0.0",
    "react-router-dom": "^7.9.5",
    "recharts": "^2.15.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^3.12.2",
    "sql.js": "^1.13.0",
    "streamdown": "^1.6.10",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.1",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.1",
    "png2icons": "^2.0.1",
    "sharp": "^0.34.5",
    "tw-animate-css": "^1.3.6",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.intvra.ai",
    "productName": "Ai.Intvra",
    "executableName": "AiIntvra",
    "copyright": "Copyright (C) 2026 techbro20",
    "afterPack": "./scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**",
      "dist/**",
      "electron/**",
      "node_modules/sql.js/**",
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/eng/**",
      "node_modules/bmp-js/**",
      "node_modules/idb-keyval/**",
      "node_modules/is-url/**",
      "node_modules/node-fetch/**",
      "node_modules/regenerator-runtime/**",
      "node_modules/wasm-feature-detect/**",
      "node_modules/zlibjs/**",
      "package.json",
      "LICENSE",
      "NOTICE.md"
    ],
    "asarUnpack": [
      "electron/accessibility-text.ps1",
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/eng/**",
      "node_modules/bmp-js/**",
      "node_modules/idb-keyval/**",
      "node_modules/is-url/**",
      "node_modules/node-fetch/**",
      "node_modules/regenerator-runtime/**",
      "node_modules/wasm-feature-detect/**",
      "node_modules/zlibjs/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Ai.Intvra uses the microphone for voice input and transcription.",
        "NSScreenCaptureUsageDescription": "Ai.Intvra captures screenshots so you can ask AI questions about screen content."
      },
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
