# Copy to .env and fill in. Never commit .env.

# --- Server ---
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
# Public HTTPS address of this server (used for Google's redirect URL).
PUBLIC_URL=https://api.intvra.com
# Set to 1 when running behind Caddy/Nginx so client IPs are read from X-Forwarded-For.
TRUST_PROXY=1
DATABASE_PATH=./data/intvra.db

# --- Accounts & credits ---
FREE_CREDITS=40
# Credits per answer on the free plan (40 credits / 2 = 20 trial answers). Paid plans always pay 1.
FREE_ANSWER_COST=2
# At most TRIAL_IP_LIMIT free trials per network (IPv4 address or IPv6 /64) within the window.
# Keep this above 1: mobile carriers and campuses share one IP across many people. 0 disables it.
TRIAL_IP_LIMIT=3
TRIAL_IP_WINDOW_DAYS=30
# Free credits are granted once per device. Throwaway email domains are always rejected;
# add more with a comma-separated list, or point at a full list file (one domain per line).
# BLOCKED_EMAIL_DOMAINS=example-temp.com,another-temp.net
# ALLOWED_EMAIL_DOMAINS=
# DISPOSABLE_DOMAINS_FILE=./data/disposable_email_blocklist.conf
SESSION_DAYS=90
SUPPORT_EMAIL=support@intvra.com
# Landing page (used for Terms/Privacy/Download links). Use your Vercel address until you have a domain.
SITE_URL=https://ai.intvra.com

# --- Payments: Paystack (M-Pesa, card, Apple Pay) ---
# Dashboard > Settings > API Keys & Webhooks. Start with the sk_test_/pk_test_ pair.
# Webhook URL to enter there: https://api.intvra.com/billing/paystack/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Prices are charged in US dollars (5 / 15 / 200); your Paystack account needs USD enabled.
# Only change these to charge in another currency, with prices in that currency's main unit.
# PAYSTACK_CURRENCY=USD
# PAYSTACK_PRICE_PAYG=5
# PAYSTACK_PRICE_PRO=15
# PAYSTACK_PRICE_LIFETIME=200
# Apple Pay: save Paystack's domain file as public/.well-known/apple-developer-merchantid-domain-association
# and register this server's domain for Apple Pay in the Paystack dashboard.

# --- Payments: crypto (prices are the USD plan prices: 5 / 15 / 200) ---
# One BNB Smart Chain address receives both USDT and USDC (BEP20).
CRYPTO_BSC_ADDRESS=
# Ethereum address for USDC (ERC20).
CRYPTO_ETH_ADDRESS=
CRYPTO_LTC_ADDRESS=
# Optional tuning.
# BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
# BSC_CONFIRMATIONS=5
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# ETH_CONFIRMATIONS=12
# LTC_API_URL=https://litecoinspace.org/api
# LTC_CONFIRMATIONS=2
# CRYPTO_ORDER_MINUTES=120
# LTC_QUOTE_MINUTES=30

# --- Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application") ---
# Authorized redirect URI: https://api.intvra.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email sign-in codes (resend.com, domain intvra.com verified) ---
RESEND_API_KEY=
EMAIL_FROM="Ai.Intvra <noreply@intvra.com>"

# --- AI answers (any OpenAI-compatible provider; default is Groq) ---
AI_BASE_URL=https://api.groq.com/openai/v1
# Comma-separated. Groq's limits belong to the account, not the key: extra keys
# only add capacity when each one is from a different Groq account. Keys from
# the same account share one limit, and the server moves on to the next model.
AI_API_KEYS=
# Tried in order; the next model is used when one is rate-limited or unavailable.
AI_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,llama-3.1-8b-instant
# Optional models that accept screenshots. When empty, screenshots are sent as text only.
AI_VISION_MODELS=
# Optional separate provider for screenshots (defaults to the AI provider and keys above).
# Gemini example: VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# VISION_BASE_URL=
# VISION_API_KEYS=
AI_MAX_OUTPUT_TOKENS=2048

# --- Speech-to-text (defaults to the AI provider and keys above) ---
STT_MODEL=whisper-large-v3-turbo
# STT_BASE_URL=
# STT_API_KEYS=
STT_DAILY_LIMIT=1500
# Daily transcription cap for free-plan accounts.
FREE_STT_DAILY_LIMIT=300
